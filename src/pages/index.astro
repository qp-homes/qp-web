---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Skyline from '../components/Skyline.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';import { photos, type PhotoKey } from '../data/photos';
import { site, primaryCta } from '../data/site';
import { primaryServices, supportServices, services, serviceHref } from '../data/services';
import { areas, laCountyCities } from '../data/areas';

const headline = 'Professional Commercial Cleaning Services in Los Angeles';

// Full-bleed hero sequence. First slide is the LCP image.
const heroSlides: { key: PhotoKey; position: string }[] = [
  { key: 'cartSmiling', position: '50% 20%' },
  { key: 'powerWashPatio', position: '50% 55%' },
  { key: 'storefrontGlass', position: '50% 35%' },
  { key: 'twoMembersMopping', position: '60% 60%' },
];

const commitments = [
  {
    title: 'Owner-level oversight',
    text: `Quality Plus is led by its founder, ${site.founder}, who stays close to daily operations and to the clients the team serves.`,
  },
  {
    title: 'A plan for each facility',
    text: 'Scope, frequency, and priorities are written for your property after we see it — not pulled from a generic checklist.',
  },
  {
    title: 'Consistent communication',
    text: 'You know who to call. Requests, schedule changes, and follow-ups go to a real person who knows your account.',
  },
  {
    title: 'An identifiable team',
    text: 'Our team works in Quality Plus uniforms, so your staff, tenants, and customers always know who is in the building.',
  },
];

const gallery = [
  { photo: 'teamGroup', caption: 'The Quality Plus team.' },
  { photo: 'storefrontGlass', caption: 'Storefront glass, downtown Los Angeles.' },
  { photo: 'fitnessRoom', caption: 'Building amenity: fitness room floor care.' },
  { photo: 'powerWashPatio', caption: 'Patio power washing with a surface cleaner.' },
  { photo: 'elevatorThreshold', caption: 'Detail work on an elevator threshold.' },
  { photo: 'counterSanitizing', caption: 'Restroom counters and fixtures.' },
  { photo: 'twoMembersMopping', caption: 'Cleaning a large floor in a commercial space.' },
  { photo: 'archwayDusting', caption: 'High dusting on a building exterior.' },
] as const;

const faqs = [
  {
    q: 'What kinds of facilities do you clean?',
    a: 'We focus on commercial facilities: retail stores, medical offices, office and multi-tenant buildings, and shared building amenities. We do not offer residential cleaning.',
  },
  {
    q: 'Can we request a walkthrough before getting a proposal?',
    a: 'Yes — that is how every new account starts. We visit your facility, review the scope and access, and then prepare a written proposal.',
  },
  {
    q: 'Do you create custom cleaning schedules?',
    a: 'Yes. Frequency and timing are set per area of your facility and around your operating hours. We confirm what is possible during the walkthrough.',
  },
  {
    q: 'Which service areas do you cover?',
    a: 'Los Angeles County is our primary service area. We also review projects in Orange County, San Bernardino County, and the San Diego area on a case-by-case basis.',
  },
  {
    q: 'Can additional services be included in our plan?',
    a: 'Yes. Power washing, window cleaning, and carpet cleaning can be added to a regular plan or scheduled on their own.',
  },
];

const ticker = services.map((s) => s.name);---

<BaseLayout
  title="Commercial Cleaning Services Los Angeles | Quality Plus"
  description="Quality Plus Building Services provides retail, medical office, and commercial building cleaning in Los Angeles. Request a site walkthrough."
  heroOverlay
>
  <!-- ============ Hero ============ -->
  <section class="hero" data-hero>
    <div class="hero-bg" data-hero-bg aria-hidden="true">
      {
        heroSlides.map((s, i) => (
          <div class="slide" style={`--i:${i}; --pos:${s.position}`}>
            <Photo
              photo={photos[s.key]}
              decorative
              priority={i === 0}
              sizes="100vw"
              widths={[640, 960, 1280, 1600, 2000]}
            />
          </div>
        ))
      }
    </div>
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="container hero-content" data-hero-content>
      <p class="eyebrow">Commercial cleaning in Los Angeles</p>
      <h1 aria-label={headline}>{headline.split(' ').map((w, i) => <><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{' '}</>)}</h1>
      <div class="hero-foot">
        <p class="lead">
          Reliable cleaning solutions for retail stores, medical offices, and commercial buildings. Tell us about your
          facility, and our team will help you plan the right service.
        </p>
        <div class="btn-row" data-hide-mobile-bar>
          <a href={primaryCta.href} class="btn" data-magnetic>{primaryCta.label} <Icon name="arrow" /></a>
          <a href="/commercial-cleaning-services/" class="btn btn--ghost" data-magnetic>Explore Commercial Services</a>
        </div>
      </div>
      <div class="hero-meta">
        <p class="trust">
          <Icon name="pin" />
          <span>Based in Los Angeles · Serving businesses across Los Angeles County</span>
        </p>
        <span class="scroll-cue" aria-hidden="true"><span></span>Scroll</span>
      </div>
    </div>
    <Skyline tone="light" class="hero-skyline" />
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => <span class="ticker-group">{ticker.map((t) => <span>{t}<i>✦</i></span>)}</span>)}
    </div>
  </div>

  <!-- ============ Statement ============ -->
  <section class="section statement-sec" aria-label="Our approach">
    <div class="container">
      <p class="eyebrow">Our approach</p>
      <p class="statement" data-scrub-words>
        Every facility runs differently. We walk it with you first — then build a cleaning plan your staff, tenants,
        and customers will actually notice.
      </p>
    </div>
  </section>

  <!-- ============ Core services (pinned horizontal on desktop) ============ -->
  <section class="svc dark" data-hscroll aria-labelledby="pillars-title">
    <div class="svc-track" data-hscroll-track>
      <div class="panel svc-intro">
        <p class="eyebrow">Core services</p>
        <h2 id="pillars-title">Commercial Cleaning Built Around Your Business</h2>
        <p class="lead">
          Three facility types, three different sets of priorities. Each plan starts with how your space is used — and
          who walks through it every day.
        </p>
        <p class="hint" aria-hidden="true">Keep scrolling <Icon name="arrow" /></p>
      </div>

      {
        primaryServices.map((s, i) => (
          <article class="panel svc-panel" aria-labelledby={`svc-${s.slug}`}>
            <a
              href={serviceHref(s.slug)}
              class="svc-media frame"
              data-cursor="View"
              tabindex="-1"
              aria-hidden="true"
              style={`view-transition-name: svc-${s.slug}`}
            >
              <div class="svc-img" data-hscroll-img>
                <Photo photo={photos[s.hero]} decorative sizes="(min-width: 64rem) 45vw, 100vw" widths={[480, 800, 1200, 1600]} />
              </div>
            </a>
            <div class="svc-copy">
              <span class="svc-num">0{i + 1}</span>
              <h3 id={`svc-${s.slug}`}>{s.name}</h3>
              <p class="svc-sum">{s.summary}</p>
              <ul role="list" class="tags">
                {s.facilities.slice(0, 3).map((f) => <li class="tag">{f}</li>)}
              </ul>
              <a href={serviceHref(s.slug)} class="link svc-link">
                Explore {s.name} <Icon name="arrow" />
              </a>
            </div>
          </article>
        ))
      }

      <div class="panel svc-end">
        <p class="end-title">Not sure which plan fits your facility?</p>
        <p class="muted">A walkthrough answers that in under an hour.</p>
        <div class="btn-row">
          <a href={primaryCta.href} class="btn" data-magnetic>{primaryCta.label} <Icon name="arrow" /></a>
        </div>
        <a href="/commercial-cleaning-services/" class="link">All commercial services <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="svc-progress" aria-hidden="true"><span data-hscroll-progress></span></div>
  </section>

  <!-- ============ Supporting services ============ -->
  <section class="section alt" aria-labelledby="support-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Additional services</p>
          <h2 id="support-title">Additional Facility Cleaning Solutions</h2>
        </div>
        <p class="lead">
          Add specialized work to your regular plan, or schedule it on its own — with the same team you already know.
        </p>
      </div>
      <ul role="list" class="support">
        {
          supportServices.map((s, i) => (
            <li class="support-item">
              <a href={serviceHref(s.slug)} data-cursor="View">
                <div class="stack" data-rise3d>
                  <div class="frame" data-tilt>
                    <Photo photo={photos[s.hero]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" widths={[480, 720, 960]} aspect={4 / 5} />
                  </div>
                </div>
                <span class="index">0{i + 1}</span>
                <h3>{s.name}</h3>
                <p class="muted">{s.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Why Quality Plus ============ -->
  <section class="section why" aria-labelledby="why-title">
    <div class="container why-grid">
      <div class="why-media">
        <div class="why-plate" aria-hidden="true"></div>
        <div class="frame why-main" data-clip data-tilt>
          <Photo photo={photos.officeTeamKarla} sizes="(min-width: 64rem) 36vw, 90vw" widths={[480, 720, 960, 1200]} aspect={4 / 5} />
        </div>
        <p class="why-chip" data-parallax="0.08"><span></span>Real Quality Plus team</p>
        <div class="frame why-inset" data-parallax="-0.06">
          <Photo photo={photos.twoMembersOrangeWall} sizes="(min-width: 64rem) 16vw, 40vw" widths={[320, 480, 640]} aspect={3 / 4} />
        </div>
      </div>
      <div class="why-copy">
        <p class="eyebrow">Why Quality Plus</p>
        <h2 id="why-title">Experience, Accountability, and Attention to Detail</h2>
        <p class="lead">
          Larger companies can feel distant. We stay close: the people who plan your service are the people who answer
          your call.
        </p>
        <ol role="list" class="commitments">
          {
            commitments.map((c, i) => (
              <li data-reveal style={`--d:${i}`}>
                <span class="index">0{i + 1}</span>
                <div>
                  <h3>{c.title}</h3>
                  <p class="muted">{c.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a href="/about/" class="link">Meet Quality Plus <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <Process />

  <!-- ============ Coverage ============ -->
  <section class="section coverage" aria-labelledby="coverage-title">
    <Skyline class="cov-line" />
    <div class="container cov-grid">
      <div>
        <p class="eyebrow">Service coverage</p>
        <h2 id="coverage-title">Commercial Cleaning Across the Los Angeles Area</h2>
        <p class="lead">
          Los Angeles County is our home and primary service area — from Downtown LA and the Westside to the San Gabriel
          Valley, the South Bay, and the Antelope Valley.
        </p>
        <p class="big-count" aria-hidden="true"><b data-count>{laCountyCities.length}</b><span>cities in LA County</span></p>
        <div class="btn-row">
          <a href="/service-areas/los-angeles-county/" class="btn btn--ghost" data-magnetic>
            Check cities in LA County <Icon name="arrow" />
          </a>
        </div>
      </div>
      <ul role="list" class="regions">
        {
          areas.map((a, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a href={`/service-areas/${a.slug}/`}>
                <span class="r-name">{a.name}</span>
                <span class:list={['r-status', { primary: a.indexable }]}>
                  {a.indexable ? `Primary area · ${laCountyCities.length} cities` : 'Projects reviewed by request'}
                </span>
                <Icon name="arrow" class="r-go" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Proof ============ -->
  <section class="section alt proof" aria-labelledby="proof-title">
    <div class="container section-head section-head--split">
      <div>
        <p class="eyebrow">Real people, real work</p>
        <h2 id="proof-title">See the Team Behind the Work</h2>
      </div>
      <p class="lead">
        Every photo on this site shows our own team on the job. No stock models — just the people who would be cleaning
        your facility.
      </p>
    </div>
    <Gallery items={[...gallery]} label="Photos of the Quality Plus team at work" />
  </section>

  <Faq items={faqs} />

  <CtaBand />
</BaseLayout>

<style>
  /* ================= Hero ================= */
  .hero {
    position: relative;
    min-height: calc(100svh - 3rem); /* leaves the ticker in view */
    display: grid;
    align-items: end;
    padding: calc(var(--header-h) + 2rem) 0 clamp(4.5rem, 3.5rem + 4vw, 7rem);
    background: var(--ink);
    color: var(--on-dark);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: -4% 0 0;
    z-index: -2;
    transform-origin: 50% 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .slide:first-child {
    opacity: 1;
  }
  .slide :global(img),
  .slide :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }
  @media (prefers-reduced-motion: no-preference) {
    .slide {
      animation: slide 28s linear infinite both;
      animation-delay: calc(var(--i) * 7s - 1s);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide {
      animation: none !important;
    }
  }
  @keyframes slide {
    0% {
      opacity: 0;
      transform: scale(1.12);
    }
    4% {
      opacity: 1;
    }
    25% {
      opacity: 1;
    }
    30% {
      opacity: 0;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(20 32 46 / 0.7) 0%, rgb(20 32 46 / 0.2) 32%, rgb(20 32 46 / 0.55) 62%, rgb(20 32 46 / 0.96) 100%),
      linear-gradient(90deg, rgb(20 32 46 / 0.9) 0%, rgb(20 32 46 / 0.55) 45%, rgb(20 32 46 / 0) 80%);
  }
  /* Desktop: the photos are portrait, so they fill the right side at full sharpness
     and melt into the ink background instead of being blown up across the screen. */
  @media (min-width: 64rem) {
    .hero-bg {
      left: auto;
      width: 50%;
    }
    .hero-shade {
      background:
        linear-gradient(90deg, var(--ink) 50%, rgb(20 32 46 / 0.35) 68%, rgb(20 32 46 / 0) 85%),
        linear-gradient(180deg, rgb(20 32 46 / 0.85) 0%, rgb(20 32 46 / 0) 24%, rgb(20 32 46 / 0) 70%, var(--ink) 100%);
    }
    .hero-content h1,
    .hero-foot {
      max-width: 44%;
    }
    .hero-foot {
      grid-template-columns: 1fr !important;
      justify-content: start !important;
    }
    .hero .btn-row {
      flex-wrap: wrap;
    }
  }
  .hero-content {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1vw, 2rem);
  }
  .hero .eyebrow {
    color: var(--orange);
  }
  .hero h1 {
    font-size: clamp(2.2rem, min(1.2rem + 3.2vw, 8vh), 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 19ch;
    font-variation-settings: 'wdth' 102;
    font-weight: 640;
  }
  .w {
    display: inline-block;
    overflow: clip;
    vertical-align: top;
    padding-bottom: 0.06em;
  }
  .w > span {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .w > span {
      animation: rise-word 1.2s var(--ease-out) both;
      animation-delay: calc(150ms + var(--i) * 65ms);
    }
  }
  @keyframes rise-word {
    from {
      transform: translateY(105%) rotate(4deg);
    }
  }
  .hero-foot {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }
  @media (min-width: 64rem) {
    .hero-foot {
      grid-template-columns: minmax(0, 34rem) auto;
      justify-content: space-between;
    }
  }
  .hero .lead {
    color: rgb(246 244 239 / 0.86);
  }
  .hero .btn--ghost {
    --btn-fg: var(--on-dark);
    border-color: rgb(246 244 239 / 0.55);
  }
  .hero .btn--ghost:hover {
    background: var(--on-dark);
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-foot,
    .hero-meta,
    .hero .eyebrow {
      animation: fade-up 1s 0.75s var(--ease-out) both;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .hero-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .trust {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--step--1);
    color: var(--on-dark-muted);
  }
  .trust :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--orange);
    flex: none;
  }
  .scroll-cue {
    display: none;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .scroll-cue span {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: rgb(255 255 255 / 0.25);
    overflow: hidden;
  }
  .scroll-cue span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--orange);
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue span::after {
      animation: cue 2.2s var(--ease-in-out) infinite;
    }
  }
  @keyframes cue {
    50% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
  @media (min-width: 48rem) {
    .scroll-cue {
      display: inline-flex;
    }
  }
  .hero-skyline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(3rem, 2.5rem + 3vw, 5.5rem);
    z-index: -1;
    opacity: 0.7;
  }

  /* ================= Ticker ================= */
  .ticker {
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark-muted);
    padding-block: 0.8rem;
    border-top: 1px solid var(--line-dark);
  }
  .ticker-track {
    display: flex;
    width: max-content;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      animation: marquee 38s linear infinite;
    }
  }
  .ticker-group {
    display: flex;
  }
  .ticker-group > span {
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    padding-right: 1.6rem;
    font-size: var(--step-1);
    font-weight: 640;
    letter-spacing: -0.01em;
    font-variation-settings: 'wdth' 102;
    white-space: nowrap;
  }
  .ticker-group > span {
    font-size: var(--step--1);
    font-weight: 500;
  }
  .ticker i {
    font-style: normal;
    font-size: 0.7em;
    color: var(--orange);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ================= Statement ================= */
  .statement-sec .container {
    display: grid;
    gap: 2rem;
  }
  .statement {
    font-size: clamp(1.55rem, 1.2rem + 1.6vw, 2.6rem);
    line-height: 1.22;
    font-weight: 680;
    letter-spacing: -0.02em;
    font-variation-settings: 'wdth' 102;
    max-width: 34ch;
    text-wrap: pretty;
  }
  .statement :global(.sw) {
    display: inline;
  }

  /* ================= Pinned services ================= */
  .svc {
    position: relative;
    overflow: hidden;
    padding-block: var(--section);
  }
  .svc-track {
    display: grid;
    gap: clamp(3.5rem, 3rem + 3vw, 6rem);
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
  }
  .svc-intro {
    display: grid;
    gap: 1.25rem;
    align-content: center;
  }
  .svc-intro h2 {
    font-size: var(--step-5);
  }
  .hint {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-weight: 620;
    color: var(--orange);
  }
  .hint :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .svc-panel {
    display: grid;
    gap: 1.75rem;
  }
  .svc-media {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: var(--ink-3);
  }
  .svc-img {
    position: absolute;
    inset: 0 -9%;
  }
  .svc-img :global(img),
  .svc-img :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-copy {
    display: grid;
    gap: 1rem;
    align-content: center;
    justify-items: start;
  }
  .svc-num {
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    line-height: 0.8;
    font-weight: 800;
    font-variation-settings: 'wdth' 125;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(64 148 220 / 0.85);
  }
  .svc-copy h3 {
    font-size: clamp(1.7rem, 1.45rem + 1.1vw, 2.5rem);
  }
  .svc-sum {
    font-size: var(--step-1);
    color: var(--on-dark-muted);
    max-width: 30rem;
  }
  .svc-link {
    color: var(--orange);
    margin-top: 0.5rem;
  }
  .svc-end {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    align-content: center;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-lg);
  }
  .end-title {
    font-size: var(--step-3);
    font-weight: 640;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variation-settings: 'wdth' 102;
    max-width: 14ch;
  }
  .svc-end .link {
    color: var(--on-dark);
  }
  .svc-progress {
    display: none;
  }
