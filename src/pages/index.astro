<script>
  import '../scripts/motion';

  // Light parallax for the inset photo (independent of GSAP; skipped for reduced motion / small screens)
  const els = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const ok = window.matchMedia('(prefers-reduced-motion: no-preference) and (min-width: 48rem)');
  let ticking = false;
  const update = () => {
    ticking = false;
    const vh = window.innerHeight;
    els.forEach((el) => {
      if (!ok.matches) return void (el.style.transform = '');
      const r = el.getBoundingClientRect();
      if (r.bottom < 0 || r.top > vh) return;
      el.style.transform = `translate3d(0, ${((r.top + r.height / 2 - vh / 2) * Number(el.dataset.parallax)).toFixed(1)}px, 0)`;
    });
  };
  if (els.length) {
    update();
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  }
</script>
