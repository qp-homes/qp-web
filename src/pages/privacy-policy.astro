---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';

// PENDING_CLIENT_APPROVAL: draft for legal review before publication.
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Privacy Policy', href: '/privacy-policy/' },
];
const updated = 'October 29, 2026';
---

<BaseLayout
  title="Privacy Policy | Quality Plus Building Services"
  description="How Quality Plus Building Services collects, uses, and protects the information you share through our website, phone, and email."
  breadcrumbs={breadcrumbs}
>
  <article class="section--tight">
    <div class="container narrow">
      <Breadcrumbs items={breadcrumbs} />
      <header>
        <h1>Privacy Policy</h1>
        <p class="muted">Last updated: {updated}</p>
      </header>

      <div class="prose policy">
        <p>
          This Privacy Policy explains how {site.name} (“Quality Plus,” “we,” “us”) collects, uses, and protects
          information when you visit this website or contact us about our commercial cleaning services.
        </p>

        <h2>Information we collect</h2>
        <p>When you request a site walkthrough or contact us, you may share:</p>
        <ul>
          <li>Contact details such as your name, business name, email address, and phone number.</li>
          <li>Facility details such as the property address or ZIP code, county, city, facility type, approximate size, and the services you are interested in.</li>
          <li>Any additional information you choose to include in your message.</li>
        </ul>
        <p>
          Please do not send patient, medical, or other sensitive personal information through our website. We do not
          need it to plan commercial cleaning services.
        </p>
        <p>
          Like most websites, our hosting provider may automatically record technical information such as IP address,
          browser type, and pages visited for security and performance purposes.
        </p>

        <h2>How we use information</h2>
        <ul>
          <li>To respond to your request and schedule a site walkthrough.</li>
          <li>To prepare proposals and provide the services you request.</li>
          <li>To communicate with you about your account, schedule, and service.</li>
          <li>To keep our website secure and improve how it works.</li>
        </ul>

        <h2>How we share information</h2>
        <p>
          We do not sell your personal information. We share it only with service providers who help us operate our
          business — for example, website hosting, email, or customer relationship tools — and only as needed for them to
          perform those services, or when required by law.
        </p>

        <h2>Cookies and analytics</h2>
        <p>
          If we use analytics or similar tools to understand how visitors use our website, we will describe them here and
          provide any choices required by law.
        </p>

        <h2>Data retention and security</h2>
        <p>
          We keep information only as long as needed for the purposes described above or as required by law, and we use
          reasonable safeguards to protect it. No method of transmission over the internet is completely secure.
        </p>

        <h2>Your California privacy rights</h2>
        <p>
          Depending on applicable law, California residents may have the right to request access to, correction of, or
          deletion of their personal information, and not to be discriminated against for exercising these rights. To
          make a request, contact us using the details below.
        </p>

        <h2>Contact us</h2>
        <p>
          {site.name}<br />
          {site.showAddress && <>{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}<br /></>}
          Phone: <a href={site.phoneHref}>{site.phone}</a><br />
          Email: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>

        <h2>Changes to this policy</h2>
        <p>We may update this policy from time to time. The “Last updated” date above shows when it was last revised.</p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow {
    max-width: 48rem;
  }
  header {
    margin: 2.5rem 0 2.5rem;
    display: grid;
    gap: 0.75rem;
  }
  h1 {
    font-size: var(--step-4);
  }
  .policy h2 {
    font-size: var(--step-2);
    margin: 2.5rem 0 0.75rem;
  }
  .policy ul {
    padding-left: 1.25rem;
    margin-top: 0.75rem;
    display: grid;
    gap: 0.4rem;
  }
  .policy p + ul,
  .policy ul + p {
    margin-top: 1rem;
  }
</style>
