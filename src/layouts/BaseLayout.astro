---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import fontUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';
import { isNoindex } from '../data/indexing';
import { businessSchema, breadcrumbSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  breadcrumbs?: { name: string; href: string }[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
  /** Page opens with a full-bleed dark hero: header floats over it. */
  heroOverlay?: boolean;
}

const { title, description, breadcrumbs, schema = [], ogImage = '/og-image.jpg', heroOverlay = false } = Astro.props;
const base = Astro.site ?? new URL(Astro.url.origin);
const path = Astro.url.pathname;
const noindex = Astro.props.noindex ?? isNoindex(path);
const canonical = new URL(path, base).href;
const ogUrl = new URL(ogImage, base).href;

const jsonLd = [
  businessSchema(base),
  ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs, base)] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#14202e" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Quality Plus Building Services team" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <!-- Analytics (GA4) intentionally not included yet. See INTEGRATIONS_LATER.md. -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={heroOverlay} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />

    <script>
      // Reveal-on-scroll and line drawing. Content is visible without JS
      // and when the user prefers reduced motion (handled in CSS).
      const items = document.querySelectorAll('[data-reveal], [data-draw]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
