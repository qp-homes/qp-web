---
/**
 * Fixed backdrop for the After Hours prototype: one night in a commercial building,
 * driven by scroll. Decorative only. Without JS or with reduced motion it stays
 * as a static night scene, so the page content is never affected.
 */
const floors = 14;
const cols = 9;
const skyline =
  'M0 110H60V92H84V80H110V96H140V70H158V62H176V70H190V100H230V86H250V54H262V44H274V54H290V88H330V100H360V72H378V60H396V72H410V96H450V40H462V28L468 14L474 28H486V40H500V90H540V66H556V50H574V66H590V98H630V20H640V8H652V20H662V84H700V58H724V100H760V76H790V48L800 36L810 48V82H850V94H880V62H904V70H920V100H960V80H990V66H1010V90H1050V74H1070V96H1110V86H1140V104H1200V120H0Z';
// Deterministic patterns, so server and client always draw the same scene.
const lit = (f: number, c: number) => (f * 7 + c * 13) % 5 !== 0;
const warm = (f: number, c: number) => ['#f4dfae', '#f7e7c4', '#e9cf97', '#f1d9a5'][(f * 3 + c * 5) % 4];
const stars = Array.from({ length: 70 }, (_, i) => ({
  x: (i * 367) % 1600,
  y: (i * 211) % 520,
  r: 0.6 + (i % 3) * 0.35,
  o: 0.3 + (i % 5) * 0.14,
}));
const cityLights = Array.from({ length: 420 }, (_, i) => ({
  x: (i * 53) % 1600,
  y: 620 + ((i * 97) % 280),
  o: 0.25 + (i % 4) * 0.2,
}));
const windowX = (c: number) => 24 + c * 39;
const windowY = (f: number) => 22 + (floors - 1 - f) * 50;
---

<div class="scene" data-scene aria-hidden="true">
  <div class="sky sky-night" data-sky="night"></div>
  <div class="sky sky-dusk" data-sky="dusk"></div>
  <div class="sky sky-dawn" data-sky="dawn"></div>

  <svg class="city" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" focusable="false">
    <defs>
      <clipPath id="far-clip"><path d={skyline} transform="translate(-60 610) scale(1.5 2.45)"></path></clipPath>
      <clipPath id="tower-clip"><rect width="390" height="730"></rect></clipPath>
      <linearGradient id="tower-face" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#0f1926"></stop>
        <stop offset="1" stop-color="#16222f"></stop>
      </linearGradient>
      <linearGradient id="sheen" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#ffd9b0" stop-opacity="0"></stop>
        <stop offset="0.5" stop-color="#ffd9b0" stop-opacity="0.5"></stop>
        <stop offset="1" stop-color="#ffd9b0" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="haze" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#9fc9ef" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#9fc9ef" stop-opacity="0.13"></stop>
      </linearGradient>
    </defs>

    <g class="stars" data-stars>
      {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />)}
    </g>
    <circle class="moon" data-moon cx="330" cy="150" r="30"></circle>

    <g data-far>
      <path class="far" d={skyline} transform="translate(-60 610) scale(1.5 2.45)"></path>
      <g class="city-lights" data-city-lights clip-path="url(#far-clip)">
        {cityLights.map((l) => <rect x={l.x} y={l.y} width="4" height="6" opacity={l.o} />)}
      </g>
    </g>
    <rect x="0" y="560" width="1600" height="340" fill="url(#haze)"></rect>

    <g transform="translate(1000 170)">
      <polygon class="tower-side" points="-64,26 0,0 0,730 -64,730"></polygon>
      <rect width="390" height="730" fill="url(#tower-face)" class="tower-body"></rect>
      <rect class="tower-top" x="145" y="-46" width="100" height="46"></rect>
      <rect class="tower-top" x="192" y="-110" width="6" height="64"></rect>
      <circle class="beacon" cx="195" cy="-112" r="4"></circle>
      {Array.from({ length: floors + 1 }, (_, f) => <rect class="band" x="0" y={f * 50 + 8} width="390" height="3" />)}
      {
        Array.from({ length: floors }, (_, f) => (
          <g data-floor={f}>
            <g class="glass">
              {Array.from({ length: cols }, (_, c) => <rect x={windowX(c)} y={windowY(f)} width="26" height="30" />)}
            </g>
            <g class="clean" data-clean>
              {Array.from({ length: cols }, (_, c) => <rect x={windowX(c)} y={windowY(f)} width="26" height="30" />)}
            </g>
            <g class="office" data-office>
              {Array.from({ length: cols }, (_, c) => lit(f, c) && <rect x={windowX(c)} y={windowY(f)} width="26" height="30" fill={warm(f, c)} />)}
            </g>
            <g class="crew" data-crew>
              {Array.from({ length: cols }, (_, c) => <rect x={windowX(c)} y={windowY(f)} width="26" height="30" />)}
            </g>
          </g>
        ))
      }
      <g class="worker" data-worker>
        <circle cx="0" cy="-20" r="3.2"></circle>
        <path d="M-3.6 -16h7.2l1 11h-1.8l-.6 5h-4.4l-.6 -5h-1.8z"></path>
        <path class="mop" d="M5 -14 L11 0"></path>
      </g>
      <g clip-path="url(#tower-clip)">
        <rect class="sheen" data-sheen x="-200" y="0" width="200" height="730" fill="url(#sheen)"></rect>
      </g>
    </g>

    <g data-near>
      <path class="near" d={skyline} transform="translate(-60 760) scale(1.5 1.2)"></path>
    </g>
  </svg>

  <div class="scrim" data-scrim></div>
</div>

<p class="clock" data-clock aria-hidden="true"><span data-live-time>6:00 PM</span></p>

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: #0d1622;
  }
  .sky {
    position: absolute;
    inset: 0;
    opacity: 0;
    will-change: opacity;
  }
  .sky-dusk {
    background: linear-gradient(180deg, #14202e 0%, #2b3c58 48%, #8a5a55 76%, #e07a3a 100%);
  }
  .sky-night {
    opacity: 1;
    background: linear-gradient(180deg, #0a121c 0%, #101c2c 60%, #1b2a3b 100%);
  }
  .sky-dawn {
    background:
      radial-gradient(60% 45% at 62% 100%, rgb(255 190 120 / 0.75), rgb(255 190 120 / 0) 70%),
      linear-gradient(180deg, #14202e 0%, #27486a 45%, #b9785a 78%, #f6a15f 100%);
  }
  .city {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Narrow screens: centre the tower instead of cropping it away. */
  @media (max-width: 63.99rem) {
    .city {
      inset: 0 auto 0 50%;
      width: 178svh;
      max-width: none;
      transform: translateX(calc(-50% - 44svh));
    }
  }
  .stars {
    fill: #dfe9f5;
  }
  .moon {
    fill: #e8edf2;
    filter: drop-shadow(0 0 18px rgb(232 237 242 / 0.55));
    opacity: 0.85;
  }
  .far {
    fill: #1b2a3b;
    opacity: 0.85;
  }
  .city-lights {
    fill: #f0d49a;
  }
  .near {
    fill: #0a121c;
  }
  .tower-body {
    stroke: rgb(159 201 239 / 0.22);
    stroke-width: 1;
  }
  .tower-side {
    fill: #0b131d;
  }
  .tower-top {
    fill: #101a27;
  }
  .band {
    fill: rgb(159 201 239 / 0.05);
  }
  .glass {
    fill: #1a2a3b;
  }
  .clean {
    fill: var(--sky-soft);
    opacity: 0;
  }
  .office {
    opacity: 0.05;
  }
  .crew {
    fill: #ffb070;
  }
  .crew rect {
    opacity: 0;
  }
  .worker {
    fill: #0a121c;
    stroke: none;
    opacity: 0;
  }
  .mop {
    fill: none;
    stroke: #0a121c;
    stroke-width: 1.4;
  }
  .beacon {
    fill: #ff4d3d;
  }
  @media (prefers-reduced-motion: no-preference) {
    .beacon {
      animation: beacon 2.6s ease-in-out infinite;
    }
  }
  @keyframes beacon {
    50% {
      opacity: 0.15;
    }
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: rgb(10 18 28 / 0.86);
  }
  @media (min-width: 64rem) {
    .scrim {
      background: linear-gradient(90deg, rgb(10 18 28 / 0.86) 0%, rgb(10 18 28 / 0.68) 48%, rgb(10 18 28 / 0.08) 72%);
    }
  }
  .clock {
    display: none;
    position: fixed;
    right: var(--gutter);
    bottom: 1.5rem;
    z-index: 5;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line-dark);
    border-radius: 99px;
    background: rgb(10 18 28 / 0.72);
    color: var(--on-dark);
    font-size: var(--step--1);
    font-weight: 620;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 48rem) and (prefers-reduced-motion: no-preference) {
    :global(.js) .clock {
      display: block;
    }
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>('[data-scene]');
  if (scene && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const range = (p: number, from: number, to: number) => clamp((p - from) / (to - from));
    const q = <T extends Element>(s: string) => scene.querySelector<T>(s)!;
    const dusk = q<HTMLElement>('[data-sky="dusk"]');
    const dawn = q<HTMLElement>('[data-sky="dawn"]');
    const scrim = q<HTMLElement>('[data-scrim]');
    const stars = q<SVGGElement>('[data-stars]');
    const moon = q<SVGCircleElement>('[data-moon]');
    const cityLights = q<SVGGElement>('[data-city-lights]');
    const far = q<SVGGElement>('[data-far]');
    const near = q<SVGGElement>('[data-near]');
    const worker = q<SVGGElement>('[data-worker]');
    const sheen = q<SVGRectElement>('[data-sheen]');
    const floors = [...scene.querySelectorAll<SVGGElement>('[data-floor]')].map((floor) => ({
      index: Number(floor.dataset.floor),
      office: floor.querySelector<SVGGElement>('[data-office]')!,
      clean: floor.querySelector<SVGGElement>('[data-clean]')!,
      crew: [...floor.querySelectorAll<SVGRectElement>('[data-crew] rect')],
    }));
    const times = [...document.querySelectorAll<HTMLElement>('[data-live-time]')];
    const interludes = [...document.querySelectorAll<HTMLElement>('[data-interlude]')];
    const end = document.querySelector<HTMLElement>('[data-dawn-end]');
    const total = floors.length;
    const crewLength = 0.05;

    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      // The night ends with the closing section; the footer sits past it.
      const last = end ? end.offsetTop + end.offsetHeight - vh : document.body.scrollHeight;
      const p = clamp(window.scrollY / Math.max(1, last));
      const night = range(p, 0.08, 0.24) * (1 - range(p, 0.78, 0.94));

      dusk.style.opacity = String(1 - range(p, 0.04, 0.2));
      dawn.style.opacity = String(range(p, 0.8, 0.98));
      stars.style.opacity = moon.style.opacity = String(night);
      moon.style.transform = `translateY(${(p * 60).toFixed(1)}px)`;
      cityLights.style.opacity = String(0.35 + night * 0.65);
      far.style.transform = `translateX(${(-p * 40).toFixed(1)}px)`;
      near.style.transform = `translateX(${(-p * 90).toFixed(1)}px)`;
      sheen.style.transform = `translateX(${(range(p, 0.86, 1) * 800).toFixed(1)}px)`;

      // The veil lifts over each interlude so the building takes the stage.
      const focus = interludes.reduce((best, el) => {
        const r = el.getBoundingClientRect();
        return Math.max(best, 1 - Math.abs(r.top + r.height / 2 - vh / 2) / (vh * 0.55));
      }, 0);
      scrim.style.opacity = String(1 - clamp(focus) * 0.72);

      const morning = range(p, 0.84, 0.97);
      let active = -1;
      let sweep = 0;
      floors.forEach(({ index, office, clean, crew }) => {
        // Offices go dark as people leave, then the crew climbs floor by floor.
        const leaving = 1 - range(p, 0.04 + index * 0.008, 0.16 + index * 0.008);
        const start = 0.22 + (index / total) * 0.54;
        const across = range(p, start, start + crewLength);
        const done = range(p, start + crewLength, start + crewLength + 0.03);
        if (across > 0 && across < 1) {
          active = index;
          sweep = across;
        }
        crew.forEach((rect, c) => {
          rect.style.opacity = String(range(across, c / crew.length - 0.02, (c + 1) / crew.length) * (1 - done));
        });
        office.style.opacity = String(Math.max(0.05 + leaving * 0.85, morning * 0.8));
        clean.style.opacity = String(done * 0.2 * (1 - morning));
      });

      worker.style.opacity = active >= 0 ? '1' : '0';
      if (active >= 0) {
        const x = 24 + sweep * 8.6 * 39;
        const y = 22 + (total - 1 - active) * 50 + 30;
        worker.setAttribute('transform', `translate(${x.toFixed(1)} ${y})`);
      }

      const minutes = (18 * 60 + Math.round((p * 720) / 5) * 5) % 1440;
      const h = Math.floor(minutes / 60);
      const label = `${h % 12 || 12}:${String(minutes % 60).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`;
      times.forEach((t) => (t.textContent = label));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('load', onScroll);
  }
</script>
