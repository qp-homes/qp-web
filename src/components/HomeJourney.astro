---
/**
 * Home "journey" layer (decorative, progressive enhancement).
 *
 * - Ambient: a fixed backdrop behind the light sections — blueprint grid, soft
 *   brand-colored glows and a large skyline stroke that drift with the scroll,
 *   so the page never reads as flat white.
 * - Rail: a fixed chapter index (desktop) that marks where the visitor is in
 *   the tour and lets them jump between sections. Links point at existing
 *   section headings, so it works without JavaScript too.
 */
import Skyline from './Skyline.astro';

interface Props {
  chapters: { id: string; label: string }[];
}
const { chapters } = Astro.props;
---

<div class="ambient" aria-hidden="true">
  <div class="amb-grid"></div>
  <div class="amb-glow amb-glow--orange"></div>
  <div class="amb-glow amb-glow--sky"></div>
  <div class="amb-sky"><Skyline /></div>
</div>

<nav class="rail" aria-label="Page sections" data-rail>
  <span class="rail-line" aria-hidden="true"><span data-rail-fill></span></span>
  <ol role="list">
    {
      chapters.map((c, i) => (
        <li>
          <a href={`#${c.id}`} data-rail-link={c.id}>
            <span class="rail-num">0{i + 1}</span>
            <span class="rail-label">{c.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* ---------- Ambient backdrop ---------- */
  .ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    --sp: 0; /* scroll progress 0–1, set by the script below */
  }
  .amb-grid {
    position: absolute;
    inset: -10% 0;
    background-image:
      linear-gradient(rgb(20 32 46 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(20 32 46 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 80%);
    transform: translate3d(0, calc(var(--sp) * -8%), 0);
  }
  .amb-glow {
    position: absolute;
    width: 46vmax;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(70px);
  }
  .amb-glow--orange {
    top: -10vmax;
    right: -14vmax;
    background: radial-gradient(circle, rgb(246 100 21 / 0.2), transparent 65%);
    transform: translate3d(calc(var(--sp) * -55vw), calc(var(--sp) * 70vh), 0);
  }
  .amb-glow--sky {
    bottom: -16vmax;
    left: -14vmax;
    background: radial-gradient(circle, rgb(64 148 220 / 0.22), transparent 65%);
    transform: translate3d(calc(var(--sp) * 45vw), calc(var(--sp) * -60vh), 0);
  }
  .amb-sky {
    position: absolute;
    left: 0;
    bottom: 6vh;
    width: 180vw;
    opacity: 0.22;
    transform: translate3d(calc(var(--sp) * -80vw), 0, 0);
  }
  .amb-sky :global(svg) {
    height: 22vh;
  }

  /* ---------- Chapter rail ---------- */
  .rail {
    display: none;
  }
  /* Only where the page margin is wide enough to hold the rail without covering text. */
  @media (min-width: 92rem) {
    .rail {
      position: fixed;
      left: 0.6rem;
      top: 50%;
      z-index: 40;
      display: flex;
      gap: 0.6rem;
      padding: 0.8rem 0.6rem;
      border-radius: 999px;
      background: rgb(20 32 46 / 0.88);
      color: var(--on-dark);
      transform: translate(-140%, -50%);
      transition: transform 0.6s var(--ease-out);
    }
    .rail.is-on,
    .rail:focus-within {
      transform: translate(0, -50%);
    }
  }
  .rail-line {
    position: relative;
    width: 2px;
    background: var(--line-dark);
    border-radius: 2px;
  }
  .rail-line span {
    position: absolute;
    inset: 0;
    background: var(--orange);
    transform-origin: top;
    transform: scaleY(var(--rp, 0));
  }
  .rail ol {
    display: grid;
    gap: 0.35rem;
  }
  .rail a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 1.75rem;
    text-decoration: none;
    color: var(--on-dark-muted);
    font-size: 0.78rem;
    font-weight: 620;
    letter-spacing: 0.06em;
  }
  .rail-num {
    font-variant-numeric: tabular-nums;
    transition: color 0.3s;
  }
  /* Labels stay tucked away (the rail fits in the page margin); they open on hover/focus. */
  .rail-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width 0.5s var(--ease-out),
      opacity 0.3s;
  }
  .rail:hover .rail-label,
  .rail:focus-within .rail-label {
    max-width: 11rem;
    opacity: 1;
  }
  .rail a.is-current {
    color: var(--on-dark);
  }
  .rail a.is-current .rail-num {
    color: var(--orange);
  }
  .rail a:hover {
    color: var(--on-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .amb-grid,
    .amb-glow,
    .amb-sky {
      transform: none !important;
    }
  }
</style>

<script>
  const ambient = document.querySelector<HTMLElement>('.ambient');
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const fill = document.querySelector<HTMLElement>('[data-rail-fill]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')];
  const sections = links.map((a) => document.getElementById(a.dataset.railLink!)?.closest('section') ?? null);
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  let ticking = false;
  const update = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    if (ambient && !still.matches) ambient.style.setProperty('--sp', p.toFixed(4));

    // Current chapter: the last section whose top has passed the middle of the screen.
    const mid = window.innerHeight * 0.5;
    let current = -1;
    sections.forEach((s, i) => {
      if (s && s.getBoundingClientRect().top < mid) current = i;
    });
    links.forEach((a, i) => a.classList.toggle('is-current', i === current));
    if (current >= 0) links[current].setAttribute('aria-current', 'true');
    links.forEach((a, i) => i !== current && a.removeAttribute('aria-current'));
    fill?.style.setProperty('--rp', String(links.length ? (current + 1) / links.length : 0));

    const pastHero = hero ? hero.getBoundingClientRect().bottom < window.innerHeight * 0.4 : true;
    rail?.classList.toggle('is-on', pastHero);
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  update();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
</script>
