---
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Skyline from './Skyline.astro';
import type { Photo as PhotoData } from '../data/photos';
import { primaryCta, site } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  breadcrumbs: { name: string; href: string }[];
  photo?: PhotoData;
  cta?: { label: string; href: string };
  showPhone?: boolean;
  /** view-transition-name shared with the matching image on the home page */
  vtName?: string;
}
const { eyebrow, title, lead, breadcrumbs, photo, cta = primaryCta, showPhone = true, vtName } = Astro.props;
---

<section class:list={['page-hero', { 'has-photo': photo }]}>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    <div class="grid">
      <div class="copy">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lead">{lead}</p>
        <div class="btn-row" data-hide-mobile-bar>
          <a href={cta.href} class="btn">{cta.label} <Icon name="arrow" /></a>
          {
            showPhone && (
              <a href={site.phoneHref} class="btn btn--ghost" data-track="click_to_call">
                <Icon name="phone" /> {site.phone}
              </a>
            )
          }
        </div>
        <slot />
      </div>
      {
        photo && (
          <div class="media frame" style={vtName ? `view-transition-name: ${vtName}` : undefined}>
            <Photo photo={photo} priority sizes="(min-width: 64rem) 40vw, 100vw" aspect={4 / 5} />
          </div>
        )
      }
    </div>
  </div>
  <Skyline class="hero-line" />
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: 1.5rem clamp(3.5rem, 3rem + 3vw, 6rem);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  h1 {
    font-size: var(--step-5);
    max-width: 16ch;
  }
  .has-photo h1 {
    font-size: clamp(2.3rem, 1.7rem + 2.9vw, 4.4rem);
  }
  .media {
    aspect-ratio: 4 / 5;
    max-height: 70vh;
    width: 100%;
  }
  @media (min-width: 64rem) {
    .has-photo .grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
    .media {
      max-height: 38rem;
    }
  }
  .hero-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(3rem, 2rem + 4vw, 6rem);
    z-index: -1;
    opacity: 0.85;
  }
</style>
