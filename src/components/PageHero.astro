---
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Skyline from './Skyline.astro';
import type { Photo as PhotoData } from '../data/photos';
import { primaryCta, site } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  breadcrumbs: { name: string; href: string }[];
  photo?: PhotoData;
  cta?: { label: string; href: string };
  showPhone?: boolean;
  /** view-transition-name shared with the matching image on the home page */
  vtName?: string;
}
const { eyebrow, title, lead, breadcrumbs, photo, cta = primaryCta, showPhone = true, vtName } = Astro.props;
---

<section class:list={['page-hero', { 'has-photo': photo }]}>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    <div class="grid">
      <div class="copy">
        <p class="eyebrow">{eyebrow}</p>
        <h1 aria-label={title}>{title.split(' ').map((w, i) => <><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{' '}</>)}</h1>
        <p class="lead">{lead}</p>
        <div class="btn-row" data-hide-mobile-bar>
          <a href={cta.href} class="btn">{cta.label} <Icon name="arrow" /></a>
          {
            showPhone && (
              <a href={site.phoneHref} class="btn btn--ghost" data-track="click_to_call">
                <Icon name="phone" /> {site.phone}
              </a>
            )
          }
        </div>
        <slot />
      </div>
      {
        photo && (
          <div class="stack">
            <div class="media frame" data-tilt style={vtName ? `view-transition-name: ${vtName}` : undefined}>
              <Photo photo={photo} priority sizes="(min-width: 64rem) 40vw, 100vw" aspect={4 / 5} />
            </div>
          </div>
        )
      }
    </div>
  </div>
  <Skyline class="hero-line" />
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: 1.5rem clamp(3.5rem, 3rem + 3vw, 6rem);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  h1 {
    font-size: var(--step-5);
    max-width: 20ch;
  }
  .has-photo h1 {
    font-size: var(--step-5);
  }
  /* Title words rise in on load; the rest of the intro follows. */
  .w {
    display: inline-block;
    overflow: clip;
    vertical-align: top;
    padding-bottom: 0.08em;
  }
  .w > span {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .w > span {
      animation: rise-word 1.1s var(--ease-out) both;
      animation-delay: calc(120ms + var(--i) * 60ms);
    }
    .copy > :not(h1) {
      animation: fade-up 1s 0.55s var(--ease-out) both;
    }
    /* The photo is the LCP image: it moves in but is never hidden. */
    .stack {
      animation: lift 1.2s 0.2s var(--ease-out) both;
    }
  }
  @keyframes lift {
    from {
      transform: translateY(28px) rotate(1.5deg);
    }
  }
  @keyframes rise-word {
    from {
      transform: translateY(105%) rotate(4deg);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .stack {
    --plate: var(--sky);
  }
  .media {
    aspect-ratio: 4 / 5;
    max-height: 70vh;
    width: 100%;
  }
  @media (min-width: 64rem) {
    .has-photo .grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
    .media {
      max-height: 38rem;
    }
  }
  .hero-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(3rem, 2rem + 4vw, 6rem);
    z-index: -1;
    opacity: 0.85;
  }
</style>
